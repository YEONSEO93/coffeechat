<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WebSocket Test</title>
    <link rel="stylesheet" href="/main.css" />
</head>

<body>
    <h4>Chatroom for Post</h4>

    <div id="chat-messages"></div>

    <form id="chat-form">
        <textarea id="message" placeholder="Write a message..." required></textarea>
        <button type="submit">Send</button>
    </form>

    <script>
        let ws;

        function connectWebSocket() {
            ws = new WebSocket("ws://localhost:8080");

            ws.onopen = () => {
                console.log("WebSocket connection opened");
            };

            ws.onmessage = (event) => {
                console.log("Message received from server:", event.data);
                const chatMessages = document.getElementById("chat-messages");
                const newMessage = document.createElement("div");
                newMessage.textContent = `Server: ${event.data}`;
                chatMessages.appendChild(newMessage);
            };

            ws.onclose = (event) => {
                console.log("WebSocket connection closed. Reconnecting in 3 seconds...", event.reason);
                setTimeout(() => {
                    connectWebSocket();
                }, 3000);
            };

            ws.onerror = (error) => {
                console.error("WebSocket error:", error);
            };
        }

        connectWebSocket();

        document.getElementById("chat-form").addEventListener("submit", function (e) {
            e.preventDefault();
            const message = document.getElementById("message").value;
            if (ws.readyState === WebSocket.OPEN) {
                ws.send(message);
                console.log("Message sent to server:", message);
            } else {
                console.error("WebSocket is not open. Message not sent.");
            }
        });
    </script>
</body>

</html>